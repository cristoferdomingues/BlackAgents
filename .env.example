# black-agents is local-first. No cloud services are required for v1.
# The active workspace path and recent projects are stored locally at
# ~/.black-agents/config.json (created on first run).

# Optional: override the local config directory used to persist app settings.
# BLACK_AGENTS_CONFIG_DIR=~/.black-agents

# --- Future phases (not used in v1) ---
# Bring-your-own LLM API keys for the chat/generation feature.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
